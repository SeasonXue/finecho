{
  "name": "finecho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "bun run src/index.ts fetch",
    "rebuild": "bun run src/index.ts rebuild",
    "stats": "bun run src/index.ts stats",
    "clone": "bun run src/index.ts clone",
    "clone:build-index": "bun run src/index.ts clone:build-index",
    "clone:once": "bun run src/index.ts clone --once",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "zod": "^4.3.6"
  }
}
