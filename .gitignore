node_modules/
.DS_Store
*.log

# 环境变量：只提交 .env.example 模板
.env
.env.local
.env.*.local

# 大体积派生数据默认不入库。真正要用的是 data/channels/<slug>/raw/（源真相）
# 建议在仓库里用 git-lfs 或另外的数据仓库管理，默认忽略便于本地跑
data/channels/*/raw/audio/*
!data/channels/*/raw/audio/.gitkeep

# 数字分身派生层：SQLite 索引，删掉可由 clone:build-index 重建
data/channels/*/clone/

# 构建产物（预留）
dist/
